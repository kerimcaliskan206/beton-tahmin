\f5\b0\fs21 \AppleTypeServices \cf10 \cb6 \strokec10 import\cf9 \strokec9  pandas \cf10 \strokec10 as\cf9 \strokec9  pd\
\cf10 \strokec10 import\cf9 \strokec9  numpy \cf10 \strokec10 as\cf9 \strokec9  np\
\cf10 \strokec10 from\cf9 \strokec9  sklearn.model_selection \cf10 \strokec10 import\cf9 \strokec9  train_test_split\
\cf10 \strokec10 from\cf9 \strokec9  sklearn.preprocessing \cf10 \strokec10 import\cf9 \strokec9  StandardScaler\
