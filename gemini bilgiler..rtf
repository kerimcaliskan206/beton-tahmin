model.fit(X_train, y_train, epochs=\cf14 \strokec14 100\cf9 \strokec9 , batch_size=\cf14 \strokec14 10\cf9 \strokec9 , verbose=\cf14 \strokec14 1\cf9 \strokec9 )\
