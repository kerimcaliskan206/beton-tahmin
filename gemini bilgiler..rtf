\f5\b0\fs21 \AppleTypeServices \cf10 \cb6 \strokec10 import\cf9 \strokec9  pandas \cf10 \strokec10 as\cf9 \strokec9  pd\
\cf10 \strokec10 import\cf9 \strokec9  numpy \cf10 \strokec10 as\cf9 \strokec9  np\
\cf10 \strokec10 from\cf9 \strokec9  sklearn.model_selection \cf10 \strokec10 import\cf9 \strokec9  train_test_split\
\cf10 \strokec10 from\cf9 \strokec9  sklearn.preprocessing \cf10 \strokec10 import\cf9 \strokec9  StandardScaler\
\cf10 \strokec10 from\cf9 \strokec9  sklearn.neural_network \cf10 \strokec10 import\cf9 \strokec9  MLPRegressor\
\
\pard\pardeftab720\partightenfactor0
\cf12 \strokec12 # 1. VER\uc0\u304  SET\u304 N\u304 N Y\'dcKLENMES\u304 \cf9 \strokec9 \
\pard\pardeftab720\partightenfactor0
\cf10 \strokec10 try\cf9 \strokec9 :\
    \cf12 \strokec12 # decimal=',' parametresi sayesinde Excel'deki virg\'fcle sahip say\uc0\u305 lar\u305  Python noktaya \'e7evirerek do\u287 ru okur!\cf9 \strokec9 \
    df = pd.read_csv(\cf13 \strokec13 'Concrete_Data.csv'\cf9 \strokec9 , decimal=\cf13 \strokec13 ','\cf9 \strokec9 )\
    print(\cf13 \strokec13 "CSV Dosyas\uc0\u305  Virg\'fcl Ayrac\u305  \'c7\'f6z\'fclerek Ba\u351 ar\u305 yla Okundu!\\n"\cf9 \strokec9 )\
\cf10 \strokec10 except\cf9 \strokec9  Exception \cf10 \strokec10 as\cf9 \strokec9  e:\
    print(\cf13 \strokec13 f"Hata: 'Concrete_Data.csv' bulunamad\uc0\u305  veya okunamad\u305 . Detay: \{e\}"\cf9 \strokec9 )\
    exit()\
\
\pard\pardeftab720\partightenfactor0
\cf12 \strokec12 # S\'fctunlar\uc0\u305  kontrol edelim (Girdiler ve \'c7\u305 kt\u305 )\cf9 \strokec9 \
\cf12 \strokec12 # \uc0\u304 lk 8 s\'fctun: \'c7imento, Su, Agrega vb. Verileri\cf9 \strokec9 \
X = df.iloc[:, :-\cf14 \strokec14 1\cf9 \strokec9 ].values  \
\cf12 \strokec12 # Son s\'fctun: Concrete compressive strength (Tahmin edilecek beton g\'fcc\'fc)\cf9 \strokec9 \
y = df.iloc[:, -\cf14 \strokec14 1\cf9 \strokec9 ].values   \
\
\cf12 \strokec12 # 2. VER\uc0\u304 N\u304 N E\u286 \u304 T\u304 M VE TEST OLARAK B\'d6L\'dcNMES\u304 \cf9 \strokec9 \
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=\cf14 \strokec14 0.2\cf9 \strokec9 , random_state=\cf14 \strokec14 42\cf9 \strokec9 )\
\
\cf12 \strokec12 # 3. VER\uc0\u304 LER\u304 N \'d6L\'c7EKLEND\u304 R\u304 LMES\u304  (Scaling)\cf9 \strokec9 \
scaler = StandardScaler()\
X_train = scaler.fit_transform(X_train)\
X_test = scaler.transform(X_test)\
\
\cf12 \strokec12 # 4. YAPAY S\uc0\u304 N\u304 R A\u286 I (DER\u304 N \'d6\u286 RENME) MODEL\u304 N\u304 N KURULMASI\cf9 \strokec9 \
model = MLPRegressor(hidden_layer_sizes=(\cf14 \strokec14 16\cf9 \strokec9 , \cf14 \strokec14 8\cf9 \strokec9 ), activation=\cf13 \strokec13 'relu'\cf9 \strokec9 , solver=\cf13 \strokec13 'adam'\cf9 \strokec9 , max_iter=\cf14 \strokec14 200\cf9 \strokec9 , random_state=\cf14 \strokec14 42\cf9 \strokec9 , verbose=\cf14 \strokec14 True\cf9 \strokec9 )\
\
\cf12 \strokec12 # 5. MODEL\uc0\u304 N E\u286 \u304 T\u304 LMES\u304  (Yapay Zekan\u305 n \'d6\u287 renme S\'fcreci)\cf9 \strokec9 \
print(\cf13 \strokec13 "Yapay Sinir A\uc0\u287 \u305  \'d6\u287 renme S\'fcrecini Ba\u351 lat\u305 yor..."\cf9 \strokec9 )\
model.fit(X_train, y_train)\
\
\cf12 \strokec12 # 6. MODEL\uc0\u304 N TEST ED\u304 LMES\u304 \cf9 \strokec9 \
print(\cf13 \strokec13 "\\nYapay Zekan\uc0\u305 n Test Verisi \'dczerindeki Ba\u351 ar\u305 s\u305 :"\cf9 \strokec9 )\
y_pred = model.predict(X_test)\
\
\cf12 \strokec12 # Ortalama Mutlak Hata Hesaplama\cf9 \strokec9 \
mae = np.mean(np.\cf16 \strokec16 abs\cf9 \strokec9 (y_test - y_pred))\
