model.add(Dense(\cf14 \strokec14 16\cf9 \strokec9 , input_dim=X_train.shape[\cf14 \strokec14 1\cf9 \strokec9 ], activation=\cf13 \strokec13 'relu'\cf9 \strokec9 )) \cf12 \strokec12 # 1. Gizli Katman\cf9 \strokec9 \
model.add(Dense(\cf14 \strokec14 8\cf9 \strokec9 , activation=\cf13 \strokec13 'relu'\cf9 \strokec9 ))                              \cf12 \strokec12 # 2. Gizli Katman\cf9 \strokec9 \
model.add(Dense(\cf14 \strokec14 1\cf9 \strokec9 , activation=\cf13 \strokec13 'linear'\cf9 \strokec9 ))                             \cf12 \strokec12 # \'c7\uc0\u305 k\u305 \u351  Katman\u305 \cf9 \strokec9 \
\
\cf12 \strokec12 # 5. MODEL\uc0\u304 N DERLENMES\u304 \cf9 \strokec9 \
model.\cf16 \strokec16 compile\cf9 \strokec9 (optimizer=\cf13 \strokec13 'adam'\cf9 \strokec9 , loss=\cf13 \strokec13 'mean_squared_error'\cf9 \strokec9 , metrics=[\cf13 \strokec13 'mae'\cf9 \strokec9 ])\
\
\cf12 \strokec12 # 6. MODEL\uc0\u304 N E\u286 \u304 T\u304 LMES\u304 \cf9 \strokec9 \
