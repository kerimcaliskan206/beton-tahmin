\cf12 \strokec12 # 1. VER\uc0\u304  SET\u304 N\u304 N Y\'dcKLENMES\u304  (Excel Format\u305  \u304 \'e7in)\cf9 \strokec9 \
\cf12 \strokec12 # \uc0\u304 ndirdi\u287 in dosyan\u305 n tam ad\u305 n\u305  (\'f6rn: concrete_data.xls) buraya yaz\u305 yorsun:\cf9 \strokec9 \
df = pd.read_excel(\cf13 \strokec13 'concrete_data.xls'\cf9 \strokec9 ) \
